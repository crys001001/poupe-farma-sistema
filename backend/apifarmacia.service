

[Unit]
Description=API Poupe Farma - FastAPI
After=network.target

[Service]
User=root

# Substitua pelo caminho real onde a API está no seu servidor Linux

WorkingDirectory=/root/api_farmacia
ExecStart=/usr/bin/python3 -m uvicorn servidor:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target